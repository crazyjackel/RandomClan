{
  "$schema": "https://github.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/releases/latest/download/schema.json",
  "cards": [
    {
      "id": "BasicDraftUnit",
      "names": {
        "english": "Stray Imp",
        "chinese": "流浪小恶魔"
      },
      "card_art": "@BasicDraftUnitCardArt",
      "cost": 1,
      "card_type": "monster",
      "rarity": "uncommon",
      "class": "@ClassBasic",
      "targets_room": true,
      "targetless": false,
      "pools": [
        "MegaPool"
      ],
      "effects": [
        "@SpawnBasicDraftUnit"
      ],
      "traits": [
        "@Randomized",
        "@UnitModifier2"
      ]
    }
  ],
  "characters": [
    {
      "id": "BasicDraftUnitCharacter",
      "names": {
        "english": "Stray Imp",
        "chinese": "流浪小恶魔"
      },
      "character_art": "@BasicDraftUnitCharacterArt",
      "health": 7,
      "attack_damage": 7,
      "subtypes": [
        "@BasicSubtype"
      ]
    }
  ],
  "effects": [
    {
      "id": "SpawnBasicDraftUnit",
      "name": "CardEffectSpawnMonster",
      "target_mode": "room",
      "param_character": "@BasicDraftUnitCharacter"
    }
  ],
  "game_objects": [
    {
      "id": "BasicDraftUnitCardArt",
      "type": "card_art",
      "extensions": {
        "card_art": {
          "sprite": "@BasicDraftUnitCardSprite"
        }
      }
    },
    {
      "id": "BasicDraftUnitCharacterArt",
      "type": "character_art",
      "extensions": {
        "character_art": {
          "sprite": "@BasicDraftUnitCharacterSprite"
        }
      }
    }
  ],
  "sprites": [
    {
      "id": "BasicDraftUnitCardSprite",
      "path": "textures/card_art/BasicDraftUnit.png"
    },
    {
      "id": "BasicDraftUnitCharacterSprite",
      "path": "textures/character_art/BasicDraftUnit.png"
    }
  ]
}
