{
  "$schema": "https://github.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/releases/latest/download/schema.json",
  "cards": [
    {
      "id": "ArbitraryHorror",
      "names": {
        "english": "Arbitrary Horror",
        "chinese": "任意恐物"
      },
      "card_art": "@ArbitraryHorrorCardArt",
      "cost": 2,
      "card_type": "monster",
      "rarity": "rare",
      "class": "@ClassBasic",
      "targets_room": true,
      "targetless": false,
      "pools": [
        "MegaPool"
      ],
      "effects": [
        "@SpawnArbitraryHorror"
      ],
      "traits": [
        "@Randomized",
        "@UnitModifier3"
      ]
    }
  ],
  "characters": [
    {
      "id": "ArbitraryHorrorCharacter",
      "names": {
        "english": "Arbitrary Horror",
        "chinese": "任意恐物"
      },
      "character_art": "@ArbitraryHorrorCharacterArt",
      "health": 7,
      "attack_damage": 7,
      "subtypes": [
        "@BasicSubtype"
      ]
    }
  ],
  "effects": [
    {
      "id": "SpawnArbitraryHorror",
      "name": "CardEffectSpawnMonster",
      "target_mode": "room",
      "param_character": "@ArbitraryHorrorCharacter"
    }
  ],
  "game_objects": [
    {
      "id": "ArbitraryHorrorCardArt",
      "type": "card_art",
      "extensions": {
        "card_art": {
          "sprite": "@ArbitraryHorrorCardSprite"
        }
      }
    },
    {
      "id": "ArbitraryHorrorCharacterArt",
      "type": "character_art",
      "extensions": {
        "character_art": {
          "sprite": "@ArbitraryHorrorCharacterSprite"
        }
      }
    }
  ],
  "sprites": [
    {
      "id": "ArbitraryHorrorCardSprite",
      "path": "textures/card_art/ArbitraryHorror.png"
    },
    {
      "id": "ArbitraryHorrorCharacterSprite",
      "path": "textures/character_art/ArbitraryHorror.png"
    }
  ]
}
