{
  "$schema": "https://github.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/releases/latest/download/schema.json",
  "cards": [
    {
      "id": "ErrantGoblin",
      "names": {
        "english": "Errant Goblin",
        "chinese": "迷途哥布林"
      },
      "card_art": "@ErrantGoblinCardArt",
      "cost": 1,
      "card_type": "monster",
      "rarity": "uncommon",
      "class": "@ClassBasic",
      "targets_room": true,
      "targetless": false,
      "pools": [
        "UnitsAllBanner",
        "@UnitsBasicClanBanner"
      ],
      "effects": [
        "@SpawnErrantGoblin"
      ],
      "traits": [
        "@Randomized",
        "@UnitModifier2"
      ]
    }
  ],
  "characters": [
    {
      "id": "ErrantGoblinCharacter",
      "names": {
        "english": "Errant Goblin",
        "chinese": "迷途哥布林"
      },
      "character_art": "@ErrantGoblinCharacterArt",
      "health": 7,
      "attack_damage": 7,
      "subtypes": [
        "SubtypesData_BannerUnit",
        "@BasicSubtype"
      ]
    }
  ],
  "effects": [
    {
      "id": "SpawnErrantGoblin",
      "name": "CardEffectSpawnMonster",
      "target_mode": "room",
      "param_character": "@ErrantGoblinCharacter"
    }
  ],
  "game_objects": [
    {
      "id": "ErrantGoblinCardArt",
      "type": "card_art",
      "extensions": {
        "card_art": {
          "sprite": "@ErrantGoblinCardSprite"
        }
      }
    },
    {
      "id": "ErrantGoblinCharacterArt",
      "type": "character_art",
      "extensions": {
        "character_art": {
          "sprite": "@ErrantGoblinCharacterSprite"
        }
      }
    }
  ],
  "sprites": [
    {
      "id": "ErrantGoblinCardSprite",
      "path": "textures/card_art/BasicBannerUnit.png"
    },
    {
      "id": "ErrantGoblinCharacterSprite",
      "path": "textures/character_art/BasicBannerUnit.png"
    }
  ]
}
