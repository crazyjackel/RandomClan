{
  "$schema": "https://github.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/releases/latest/download/schema.json",
  "cards": [
    {
      "id": "BasicRoomCard",
      "cost": 2,
      "card_type": "room",
      "names": {
        "english": "Contingent Bastion",
        "chinese": "偶然堡垒"
      },
      "rarity": "uncommon",
      "targets_room": true,
      "targetless": true,
      "class": "@ClassBasic",
      "card_art": "@BasicRoomCardArt",
      "effects": [ "@BasicRoomAttach" ],
      "traits": [ "@Randomized", "@RoomModifier2" ],
      "pools": [
        "MegaPool",
        "RoomAndEquipmentMerchant_RoomPool",
        "RoomAndEquipmentDraftPool",
        "TrainRoomPool"
      ]
    }
  ],
  "effects": [
    {
      "id": "BasicRoomAttach",
      "name": "CardEffectAttachTrainRoomAttachment",
      "target_mode": "room",
      "target_team": "monsters",
      "param_upgrade": "@BasicRoomUpgrade"
    }
  ],
  "upgrades": [
    {
      "id": "BasicRoomUpgrade",
      "bonus_damage": 10,
      "bonus_hp": 10,
      "icon": "@BasicRoomIcon",
      "room_modifier_upgrades": [ "@BasicRoomAdjustCapacity" ]
    }
  ],
  "room_modifiers": [
    {
      "id": "BasicRoomAdjustCapacity",
      "name": "RoomStateCapacityModifier",
      "param_int": 2
    }
  ],
  "game_objects": [
    {
      "id": "BasicRoomCardArt",
      "type": "card_art",
      "extensions": {
        "card_art": {
          "sprite": "@BasicRoomCardSprite"
        }
      }
    }
  ],
  "sprites": [
    {
      "id": "BasicRoomCardSprite",
      "path": "textures/card_art/BasicRoom.png"
    },
    {
      "id": "BasicRoomIcon",
      "path": "textures/icons/BasicRoomIcon.png"
    }
  ]
}
